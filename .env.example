# PostgreSQL Database Connection URL
# Replace with your self-hosted or cloud PostgreSQL connection string:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Admin Authentication Credentials for /admin/careers portal
ADMIN_DEFAULT_EMAIL=admin@saanvitech.com
ADMIN_DEFAULT_PASSWORD=Admin@123
ADMIN_SECRET_KEY=saanvi-admin-2026

# Make an Appointment / Contact Form Notification Emails
# You can put multiple emails separated by commas (e.g. email1@gmail.com, email2@gmail.com):
APPOINTMENT_NOTIFICATION_EMAILS=info@saanvitechin.com,chinmaya@saanvitechin.com

# Optional: Outbound SMTP configuration to send emails via Gmail/Custom Domain
# (Inquiries are always saved safely into the database regardless of SMTP)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# EMAIL_FROM_NAME="Saanvi Technologies"
